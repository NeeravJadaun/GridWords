# Copy to .env and adjust if you want to override the defaults baked into
# docker-compose.yml. Not required for a plain `docker compose up` — every
# variable here already has a safe local-dev default.

POSTGRES_DB=wordduel
POSTGRES_USER=wordduel
POSTGRES_PASSWORD=wordduel_dev_password
POSTGRES_HOST_PORT=5433

REDIS_HOST_PORT=6380

# Must be at least 32 bytes. Only used to sign short-lived, per-match player
# tokens for this local/synthetic demo — never a real secret.
JWT_SIGNING_KEY=local-dev-signing-key-please-change-me-32bytes+
JWT_ISSUER=worddue-api
JWT_AUDIENCE=worddue-client

API_HOST_PORT=5080
WEB_HOST_PORT=3000

ASPNETCORE_ENVIRONMENT=Production
